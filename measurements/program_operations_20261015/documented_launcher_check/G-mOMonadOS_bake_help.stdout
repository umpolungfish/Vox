usage: ./programs bake [-h] [--list]
                       [--number NUMBER | --input INPUT | --word-file WORD_FILE]
                       [--output OUTPUT] [--base BASE] [--prepared PREPARED]
                       [--line LINE]
                       [--native-fourier | --retained-case RETAINED_CASE]
                       [{factor,resident,rust-phase,c-phase,ququart,gpu,cpu,word}]

positional arguments:
  {factor,resident,rust-phase,c-phase,ququart,gpu,cpu,word}

options:
  -h, --help            show this help message and exit
  --list
  --number NUMBER       decimal source N
  --input INPUT         file containing decimal N alone
  --word-file WORD_FILE
                        saved IMASM source for ququart or word
  --output OUTPUT       fresh output path, relative to your current directory
  --base BASE           decimal phase base (default: 2)
  --prepared PREPARED   prepared source directory for the CPU baker
  --line LINE           nonempty source line for word baking (default: 1)
  --native-fourier      use the ququart baker's native Fourier preparation
  --retained-case RETAINED_CASE
                        reuse a compatible retained ququart preparation
